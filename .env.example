# Copy this file to .env (or set these in your hosting provider's dashboard)
# and fill in real values to switch Inkingi from development mode
# (localStorage only) to production mode (Supabase + Cloudinary).
#
# See SETUP.md for step-by-step instructions on creating these accounts
# and where to find each value.
#
# Use ONLY the row below that matches your build tool — delete or ignore
# the other two rows' variable names.

# ── If using Vite ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=

# ── If using Next.js ──
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_CLOUDINARY_CLOUD=
# NEXT_PUBLIC_CLOUDINARY_PRESET=

# ── If using Create React App ──
# REACT_APP_SUPABASE_URL=
# REACT_APP_SUPABASE_ANON_KEY=
# REACT_APP_CLOUDINARY_CLOUD=
# REACT_APP_CLOUDINARY_PRESET=
